---
const { currentPage } = Astro.props;
---

<header class="rsb-header">
  <div class="rsb-container">
    <div class="rsb-header__inner">
      <a href="/" class="rsb-logo" aria-label="Yukings home">
        <img src="img/yukings-logo.png" alt="Yukings noise barrier & sound barrier manufacturer" loading="lazy" style="height:48px;width:auto;display:block">
      </a>
      <nav class="rsb-nav" aria-label="Primary">
        <a href="/" class="rsb-nav__item" aria-current={currentPage === 'index' ? 'page' : undefined}>Home</a>
        <span class="rsb-nav__item rsb-nav__dropdown">
          <a href="/products/" class="rsb-nav__link">Products</a>
          <div class="rsb-dropdown">
            <a href="/products/#tab-categories" class="rsb-dropdown__item">Railway Noise Barriers</a>
            <a href="/products/#tab-categories" class="rsb-dropdown__item">Highway Noise Barriers</a>
            <a href="/products/#tab-categories" class="rsb-dropdown__item">Solar Noise Barriers</a>
            <a href="/products/#tab-categories" class="rsb-dropdown__item">Industrial Noise Barriers</a>
            <a href="/products/#tab-categories" class="rsb-dropdown__item">Residential Noise Barriers</a>
          </div>
        </span>
        <span class="rsb-nav__item rsb-nav__dropdown">
          <a href="/solutions/" class="rsb-nav__link">Solutions</a>
          <div class="rsb-dropdown">
            <a href="/solutions/#railway" class="rsb-dropdown__item">Railway Noise Reduction</a>
            <a href="/solutions/#highway" class="rsb-dropdown__item">Highway Noise Control</a>
            <a href="/solutions/#industrial" class="rsb-dropdown__item">Industrial Factory Noise Barriers</a>
            <a href="/solutions/#residential" class="rsb-dropdown__item">Residential Community Noise Protection</a>
            <a href="/solutions/#solar" class="rsb-dropdown__item">Solar & Energy noise barrier & sound wall solutions</a>
          </div>
        </span>
        <span class="rsb-nav__item rsb-nav__dropdown">
          <a href="/projects/" class="rsb-nav__link">Projects</a>
          <div class="rsb-dropdown">
            <a href="/projects/#railway" class="rsb-dropdown__item">Railway noise barrier & sound wall projects</a>
            <a href="/projects/#highway" class="rsb-dropdown__item">Highway noise barrier & sound wall projects</a>
            <a href="/projects/#industrial" class="rsb-dropdown__item">Industrial Noise Control Projects</a>
            <a href="/projects/#residential" class="rsb-dropdown__item">Residential Noise Reduction Projects</a>
            <a href="/projects/#solar" class="rsb-dropdown__item">New Energy Solar Barrier Projects</a>
          </div>
        </span>
        <span class="rsb-nav__item rsb-nav__dropdown">
          <a href="/blog/" class="rsb-nav__link">Blog</a>
          <div class="rsb-dropdown">
            <a href="/blog/#technical" class="rsb-dropdown__item">Technical Articles</a>
            <a href="/blog/#news" class="rsb-dropdown__item">Industry News</a>
          </div>
        </span>
        <a href="/faqs/" class="rsb-nav__item">FAQs</a>
        <span class="rsb-nav__item rsb-nav__dropdown">
          <a href="/about/" class="rsb-nav__link">About Us</a>
          <div class="rsb-dropdown">
            <a href="/about/#tab-company" class="rsb-dropdown__item">Company Profile</a>
            <a href="/about/#tab-factory" class="rsb-dropdown__item">Factory Tour</a>
            <a href="/about/#tab-certifications" class="rsb-dropdown__item">Certifications</a>
            <a href="/about/#tab-team" class="rsb-dropdown__item">R&D Team</a>
          </div>
        </span>
        <a href="/contact/#inquiry" class="rsb-nav__item">Get Quote</a>
        <a href="/contact/" class="rsb-nav__item">Contact Us</a>
      </nav>
      <a href="/contact/#inquiry" class="rsb-btn rsb-btn--primary rsb-btn--sm">Get a Quote</a>
    </div>
  </div>
</header>